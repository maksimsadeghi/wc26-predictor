rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Leagues
    match /leagues/{leagueId} {
      allow read:  if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.adminUid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']));
    }

    // Predictions — users read/write only their own
    match /predictions/{predId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == request.resource.data.uid;
    }

    // Results — read by all; written by the caching layer (any signed-in user can trigger a fetch)
    match /results/{matchId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // Scores — read-only; written by scoring engine
    match /scores/{scoreId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // API cache — fixtures + squads stored here to save API calls
    match /_cache/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
